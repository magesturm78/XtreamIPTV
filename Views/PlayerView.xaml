<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             mc:Ignorable="d" 
             x:Class="XtreamIPTV.Views.PlayerView"
             d:DesignHeight="720" d:DesignWidth="1080">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.RowSpan="2" Text="{Binding ErrorMessage}" 
                   Foreground="White" Margin="165,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="50"/>
        <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                    Source="{Binding CurrentStreamUrl}"
                    Stretch="Uniform" MouseLeftButtonUp="Media_MouseLeftButtonUp"
                    MediaEnded="VideoPlayer_MediaEnded" Grid.ColumnSpan="2" Margin="0,0,0,30" Grid.RowSpan="2"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Name="txtCurrentPosition" Text="0:00:00" Foreground="White" />
            <Slider Grid.Column="1" Name="positionSlider" IsEnabled="False" />
            <TextBlock Grid.Column="2" Name="txtTotalDuration" Text="0:00:00" Foreground="White"/>
        </Grid>
        <StackPanel Grid.Row="2" x:Name="VideoControls" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" Visibility="Hidden" Grid.ColumnSpan="2">
            <Button Content="Play" Click="PlayButton_Click" Margin="0,0,10,0"  Width="100"/>
            <Button Content="Pause" Click="PauseButton_Click" Margin="0,0,10,0" Width="100"/>
            <Button Content="Restart" Click="StopButton_Click" Margin="0,0,10,0" Width="100"/>
            <!-- Add a Slider for progress/volume as needed -->
        </StackPanel>
    </Grid>
</UserControl>