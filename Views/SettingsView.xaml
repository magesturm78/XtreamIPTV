<UserControl x:Class="XtreamIPTV.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XtreamIPTV.Views"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="720">
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#1D252B" Offset="0.2" />
                <GradientStop Color="White" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>
        <TextBlock Grid.Column="1" Grid.Row="1" Text="Server Address" FontSize="22" FontWeight="Bold" Foreground="White" Margin="10"/>
        <TextBox x:Name="ServerAddressTextBox" Grid.Column="2" Grid.Row="1" FontSize="20" Width="300" 
                 Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                 Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <TextBlock Grid.Column="1" Grid.Row="2" Text="Username" FontSize="22" FontWeight="Bold" Foreground="White" Margin="10"/>
        <TextBox x:Name="UsernameTextBox" Grid.Column="2" Grid.Row="2" FontSize="20" Width="300" 
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <TextBlock Grid.Column="1" Grid.Row="3" Text="Password" FontSize="22" FontWeight="Bold" Foreground="White" Margin="10"/>
        <TextBox x:Name="PasswordBox" Grid.Column="2" Grid.Row="3" FontSize="20" Width="300" 
                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                 Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <Button Grid.Column="2" Grid.Row="4" Content="Save" Width="150" Height="30" Margin="10" HorizontalAlignment="Right"
                Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl} }"/>
    </Grid>
</UserControl>
