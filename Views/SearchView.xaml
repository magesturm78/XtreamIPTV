<UserControl x:Class="XtreamIPTV.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XtreamIPTV.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">
    <Grid> 
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1D252B" Offset="0.0" />
                <GradientStop Color="White" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <TextBox x:Name="SearchTextBox" FontSize="20" Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,0" Grid.ColumnSpan="2" KeyUp="SearchTextBox_KeyUp"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Grid Grid.Row="1" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >
                <TextBlock Text="Movies" FontSize="20" FontWeight="Bold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding MoviesVM.SearchedMovies.Count, StringFormat={}{0} Results}" FontSize="10" Margin="10,0,0,0" Foreground="White"/>
                <TextBlock Text="{Binding MoviesVM.AllMovies.Count, StringFormat={} / {0}}" FontSize="10" Margin="0,0,0,0" Foreground="White"/>
                <Button x:Name="PlayMovieButton" Content="Play" VerticalAlignment="Center" Margin="10,0,0,0" Background="LightBlue" FontSize="20" Click="PlayMovieButton_Click"/>
                <Button x:Name="FavoriteMovieButton" Content="Favorite" VerticalAlignment="Center" Margin="10,0,0,0" Background="LightBlue" FontSize="20" Click="FavoriteMovieButton_Click"/>
            </StackPanel>
            <ListBox x:Name="MoviesListBox" Grid.Row="1"
                     ItemsSource="{Binding MoviesVM.SearchedMovies}" 
                     SelectedItem="{Binding MoviesVM.SelectedMovie}"
                     SelectionChanged="MoviesBox_SelectionChanged"
                     BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black"  BorderThickness="4" Margin="0" Padding="0" CornerRadius="10" Background="Transparent">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Top" Background="Transparent" >
                                <Canvas Height="230" Width="154">
                                    <Image Width="154" Source="{Binding Path=Poster, TargetNullValue={x:Null}}" VerticalAlignment="Top" />
                                    <TextBlock Canvas.Left="0" Canvas.Top="198" Text="{Binding Path=Rating}" FontSize="20" Background="#7F000000"/>
                                    <!--<TextBlock Canvas.Left="0" Canvas.Top="0" Text="{Binding Path=Similiar}" Foreground="Yellow" FontSize="25" Background="#5F000000"/>-->
                                </Canvas>
                                <TextBlock x:Name="titleText" TextWrapping="Wrap" Width="150" Height="50" Text="{Binding Path=Title}" FontSize="15"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True" >
                                <Setter Property="BorderBrush" Value="Black" />
                                <Setter Property="Background" Value="Pink" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False" >
                                <Setter Property="BorderBrush" Value="White" />
                                <Setter Property="Background" Value="#2B373E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LightSteelBlue" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
        <!-- SERIES LIST -->
        <Grid Grid.Row="2" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Series" FontSize="20" FontWeight="Bold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SeriesVM.SearchedSeries.Count, StringFormat={}{0} Results}" FontSize="10" Margin="10,0,0,0" Foreground="White"/>
                <TextBlock Text="{Binding SeriesVM.AllSeries.Count, StringFormat={} / {0}}" FontSize="10" Margin="0,0,0,0" Foreground="White"/>
                <Button x:Name="FavoriteSeriesButton" Content="Favorite" VerticalAlignment="Center" Margin="10,0,0,0" Background="LightBlue" FontSize="20" Click="FavoriteSeriesButton_Click"/>
            </StackPanel>
            <ListBox x:Name="SeriesListBox" Grid.Row="1" 
                     ItemsSource="{Binding SeriesVM.SearchedSeries}" 
                     SelectedItem="{Binding SeriesVM.SelectedSeries}"
                     SelectionChanged="SeriesListBox_SelectionChanged"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black"  BorderThickness="4" Margin="0" Padding="0" CornerRadius="10" Background="Transparent">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Top" Background="Transparent" >
                                <Canvas Height="230" Width="154">
                                    <Image Width="154" Source="{Binding Path=Poster, TargetNullValue={x:Null}}" VerticalAlignment="Top" />
                                    <TextBlock Canvas.Left="0" Canvas.Top="198" Text="{Binding Path=Rating}" FontSize="20" Background="#7F000000"/>
                                </Canvas>
                                <TextBlock x:Name="titleText" TextWrapping="Wrap" Width="150" Height="50" Text="{Binding Path=Title}" FontSize="15"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True" >
                                <Setter Property="BorderBrush" Value="Black" />
                                <Setter Property="Background" Value="Pink" />
                                <Setter Property="Foreground" Value="Black" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False" >
                                <Setter Property="BorderBrush" Value="White" />
                                <Setter Property="Background" Value="#2B373E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
