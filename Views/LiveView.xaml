        </DrawingImage>
    </UserControl.Resources>
    <Grid>
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="720"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.31,0.3" EndPoint="1,1">
                    <GradientStop Color="#1D252B" Offset="0.0" />
                    <GradientStop Color="White" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <!-- CATEGORY LIST -->
            <ListBox Grid.RowSpan="2" Background="#1D252B" Foreground="White" FontSize="18" BorderThickness="0"
                 ItemsSource="{Binding Categories}" 
                 SelectedItem="{Binding SelectedCategory}"
                 DisplayMemberPath="Name" 
                 SelectionChanged="ListBox_SelectionChanged"
                 Height="{Binding ActualHeight, ElementName=LayoutRoot, TargetNullValue=100}"/>
            <!-- LIVE DETAILS -->
            <Grid Grid.Row="0" Grid.Column="1" x:Name="LiveInfoCanvas" Height="720" >
                <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                        Source="{Binding SelectedLive.StreamUrl}" Height="720" Volume="0.01"
                        Stretch="Uniform" Margin="0,0,0,0" HorizontalAlignment="Center" MouseMove="VideoPlayer_MouseMove"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="2" x:Name="VideoControls" Visibility="Hidden">
                        <Grid.Background>
                            <SolidColorBrush Color="Black" Opacity="0.15" />
                        </Grid.Background>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Margin="5,10,5,10"  Width="50" Height="50" Click="Refresh_Click" Background="Transparent" BorderThickness="0" >
                                <Path Data="M 11.324 1.6751 C 11.4489 1.4153 11.7117 1.25 12 1.25 C 12.7353 1.25 13.4541 1.3239 14.1492 1.465 C 19.0563 2.4611 22.75 6.7984 22.75 12 C 22.75 17.9371 17.9371 22.75 12 22.75 C 6.0629 22.75 1.25 17.9371 1.25 12 C 1.25 7.5907 3.9046 3.803 7.6997 2.1448 C 8.0793 1.979 8.5214 2.1522 8.6873 2.5318 C 8.8531 2.9114 8.6798 3.3535 8.3003 3.5194 C 5.0318 4.9474 2.75 8.2081 2.75 12 C 2.75 17.1086 6.8914 21.25 12 21.25 C 17.1086 21.25 21.25 17.1086 21.25 12 C 21.25 7.8495 18.5158 4.3362 14.75 3.1654 V 4.5 C 14.75 4.8185 14.5488 5.1023 14.2483 5.2077 C 13.9477 5.3132 13.6133 5.2172 13.4143 4.9685 L 11.4143 2.4685 C 11.2342 2.2434 11.1991 1.935 11.324 1.6751" 
                                Fill="White" Stretch="Uniform" Margin="5"/>
                            </Button>
                            <Image Source="{StaticResource VolumeIconData}" Width="40" Height="40" Margin="5"/>
                            <Slider Name="sldVolume" Grid.Row ="2" Value="{Binding ElementName=VideoPlayer, Path=Volume}" Minimum="0" Maximum="1" Width="400"
                        Margin="5,10,5,10" VerticalAlignment="Center" TickFrequency="0.01" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.1"/>
                            <TextBlock Text="{Binding Path=Value, ElementName=sldVolume, StringFormat={}{0:P0}}" Foreground="White" Margin="5,10,5,10" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ResolutionText" Foreground="White" Margin="5,10,5,10" VerticalAlignment="Center" FontSize="35" />
                        </StackPanel>
                    </Grid>
                        <!--<TextBlock Text="{Binding SelectedLive.Name, TargetNullValue=''}" FontSize="20" TextWrapping="Wrap" Foreground="White" Margin="0,5,0,0"/>-->
                </Grid>
            </Grid>
            <!-- LIVE LIST -->
            <ListBox x:Name="LiveListBox"  Grid.Row="1" Grid.Column="1" 
                 ItemsSource="{Binding FilteredLive}" BorderThickness="0" Background="Transparent"
                 SelectedItem="{Binding SelectedLive}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                 SelectionChanged="LiveListBox_SelectionChanged" MouseDoubleClick="LiveListBox_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="4" >
                            <StackPanel Orientation="Horizontal" Background="DarkBlue" Height="60" Width="200">
                                <!--<Image Height="50" Source="{Binding StreamIcon, TargetNullValue=''}" 
                                       VerticalAlignment="Center" HorizontalAlignment="Left" />-->

                                <TextBlock x:Name="titleText" TextWrapping="Wrap" Width="200" Text="{Binding Name, TargetNullValue=''}" 
                                           FontSize="16" Foreground="White" TextAlignment="Center" Padding="2"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
