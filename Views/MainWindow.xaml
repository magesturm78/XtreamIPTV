<Window x:Class="XtreamIPTV.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:XtreamIPTV.ViewModels"
        xmlns:controls="clr-namespace:XtreamIPTV.Controls"
        Title="{Binding Title}" Height="720" Width="1280"
        MouseMove="Window_MouseMove" KeyDown="Window_KeyDown" StateChanged="Window_StateChanged">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <controls:SideNav x:Name="sideNav" Grid.Column="0" Width="20" Visibility="{Binding MenuVisibility}"/>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}" Grid.RowSpan="2"/>
    </Grid>
</Window>