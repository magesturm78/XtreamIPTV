<UserControl x:Class="XtreamIPTV.Views.SeriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             mc:Ignorable="d" 
             x:Name="SeriesViewUC"
             d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="420"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.3,0.5" EndPoint="1,1">
                <GradientStop Color="#1D252B" Offset="0.0" />
                <GradientStop Color="White" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- CATEGORY LIST -->
        <ListBox Grid.RowSpan="2" Background="#2B373E" Foreground="White" FontSize="18" BorderThickness="0"
                 ItemsSource="{Binding Categories}" 
                 SelectedItem="{Binding SelectedCategory}"
                 SelectionChanged="ListBox_SelectionChanged"
                 DisplayMemberPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                 Height="{Binding ElementName=LayoutRoot, Path=ActualHeight, TargetNullValue=100}"/>

        <!-- SERIES DETAILS -->
        <Canvas Grid.Row="0" Grid.Column="1" x:Name="MovieInfoCanvas" Height="390" >
            <Image Source="{Binding SelectedSeries.Backdrop, TargetNullValue={x:Null}}" Height="420" Canvas.Right="20" Canvas.Top="-15"/>
            <StackPanel Width="800" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Top="8" Canvas.Left="8">
                <TextBlock Text="{Binding SelectedSeries.Title}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" Foreground="White" />
                <TextBlock Text="{Binding SelectedSeries.ReleaseInfo}" FontSize="15" TextWrapping="Wrap" Foreground="White" Margin="0,5,0,0" />
            </StackPanel>
            <ScrollViewer Height="250" Width="820" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Canvas.Top="70" Canvas.Left="8" HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel Width="800" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="{Binding SelectedSeries.Plot}" FontSize="20" TextWrapping="Wrap" Foreground="White" Margin="0,5,0,0" />
                    <WrapPanel Width="800" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Directors:" FontSize="12" TextWrapping="Wrap" Foreground="White"/>
                        <ItemsControl x:Name="DirectorsItemsControl" ItemsSource="{Binding SelectedSeries.Directors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="5,0,0,0">
                                    <Hyperlink x:Name="DirectorHyperlink" NavigateUri="{Binding Url}" RequestNavigate="DirectorHyperlink_RequestNavigate">
                                        <Run Text="{Binding Text}" FontSize="12" Foreground="White"/>
                                    </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <!-- If Count is 0, hide the parent -->
                                    <DataTrigger Binding="{Binding ElementName=DirectorsItemsControl, Path=Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                    </WrapPanel>
                    <WrapPanel x:Name="ActorsWrapPanel" Width="800" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Actors:" FontSize="12" TextWrapping="Wrap" Foreground="White"/>
                        <ItemsControl x:Name="ActorsItemsControl" ItemsSource="{Binding SelectedSeries.Actors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="5,0,0,0" >
                                    <Hyperlink x:Name="ActorHyperlink" NavigateUri="{Binding Url}" RequestNavigate="ActorHyperlink_RequestNavigate">
                                        <Run Text="{Binding Text}" FontSize="12" Foreground="White"/>
                                    </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <!-- If Count is 0, hide the parent -->
                                    <DataTrigger Binding="{Binding ElementName=ActorsItemsControl, Path=Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                    </WrapPanel>
                    <TextBlock x:Name="episodeTitle" Text="{Binding SelectedEpisode.Title}" FontSize="15" TextWrapping="Wrap" Foreground="White" Margin="0,5,0,0" />
                    <TextBlock x:Name="episodeReleaseDate" Text="{Binding SelectedEpisode.ReleaseDate}" FontSize="12" TextWrapping="Wrap" Foreground="White" Margin="5,0,0,0" />
                    <TextBlock x:Name="episodePlot" Text="{Binding SelectedEpisode.Plot}" FontSize="20" TextWrapping="Wrap" Foreground="White" Margin="0,0,0,0" />
                </StackPanel>
            </ScrollViewer>
            <!-- Series buttons -->
            <Button x:Name="EpisodesButton" Content="Episodes" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="5" Click="EpisodesButton_Click" />
            <Button x:Name="FavoriteButton" Content="Favorite" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="175" Click="FavoriteButton_Click"/>
            <Button x:Name="SimiliarButton" Content="Similiar" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="345" Click="SimiliarButton_Click"/>
            <Button x:Name="RemoveHistButton" Content="Remove" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="515" Click="RemoveHistButton_Click"/>
            <!-- Episode buttons -->
            <Button x:Name="PlayButton" Content="Play" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="175" Click="PlayButton_Click"/>
            <Button x:Name="PlayButton2" Content="External" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="5" Click="PlayButton2_Click"/>
            
            <Button x:Name="BackButton" Content="Back" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="515" Click="BackButton_Click"/>
            

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Top="-14">
                <ToggleButton x:Name="SortTogglePopupButton" Content="Sort" Margin="5,0,0,0" FontSize="15" />

                <Popup IsOpen="{Binding IsChecked, ElementName=SortTogglePopupButton}"
                           PlacementTarget="{Binding ElementName=SortTogglePopupButton}"
                           Placement="Bottom"
                           AllowsTransparency="True" 
                           StaysOpen="False">
                    <Border BorderThickness="1" Background="LightBlue" Padding="0">
                        <StackPanel x:Name="SortPanel">
                            <Button Content="Default" Click="DefaultSort_Click" FontSize="20" FontWeight="Bold"/>
                            <Button Content="Date" Click="DateSort_Click" FontSize="20"/>
                            <Button Content="Name" Click="NameSort_Click" FontSize="20"/>
                            <Button Content="Popularity" Click="PopularitySort_Click" FontSize="20"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <ToggleButton x:Name="DecadeTogglePopupButton" Content="Decade" Margin="5,0,0,0" FontSize="15" />

                <Popup IsOpen="{Binding IsChecked, ElementName=DecadeTogglePopupButton}"
                               PlacementTarget="{Binding ElementName=DecadeTogglePopupButton}"
                               Placement="Bottom"
                               AllowsTransparency="True" 
                               StaysOpen="False">
                    <Border BorderThickness="1" Background="LightBlue" Padding="0">
                        <StackPanel x:Name="DecadePanel"/>
                    </Border>
                </Popup>

                <ToggleButton x:Name="LanguageTogglePopupButton" Content="Language" Margin="5,0,0,0" FontSize="15" />

                <Popup IsOpen="{Binding IsChecked, ElementName=LanguageTogglePopupButton}"
                               PlacementTarget="{Binding ElementName=LanguageTogglePopupButton}"
                               Placement="Bottom"
                               AllowsTransparency="True" 
                               StaysOpen="False">
                    <Border BorderThickness="1" Background="LightBlue" Padding="0">
                        <StackPanel x:Name="LanguagePanel"/>
                    </Border>
                </Popup>

                <ToggleButton x:Name="AgeTogglePopupButton" Content="Age Rating" Margin="5,0,0,0" FontSize="15" />

                <Popup IsOpen="{Binding IsChecked, ElementName=AgeTogglePopupButton}"
                               PlacementTarget="{Binding ElementName=AgeTogglePopupButton}"
                               Placement="Bottom"
                               AllowsTransparency="True" 
                               StaysOpen="False">
                    <Border BorderThickness="1" Background="LightBlue" Padding="0">
                        <StackPanel x:Name="AgePanel"/>
                    </Border>
                </Popup>
            </StackPanel>
        </Canvas>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <TextBlock Text="{Binding FilteredSeries.Count, StringFormat={}{0}}" FontSize="20" Margin="10,0,0,0" Foreground="White"/>
            <TextBlock Text="{Binding FilteredSeriesCount, StringFormat={} / {0}}" FontSize="20" Margin="0,0,30,0" Foreground="White"/>
        </StackPanel>

        <!-- Series list -->
        <ListBox x:Name="SeriesListBox"  Grid.Row="1" Grid.Column="1" 
                 ItemsSource="{Binding FilteredSeries}" Background="Transparent" BorderThickness="0"
                 SelectedItem="{Binding SelectedSeries}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="SeriesListBox_SelectionChanged"  ScrollViewer.ScrollChanged="SeriesListBox_ScrollChanged" >
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black"  BorderThickness="4" Margin="0" Padding="0" CornerRadius="10" Background="Transparent">
                        <StackPanel Orientation="Vertical" VerticalAlignment="Top" Background="Transparent" >
                            <Canvas Height="230" Width="152">
                                <Image Width="154" Source="{Binding Path=Poster, TargetNullValue={x:Null}}" VerticalAlignment="Top" />
                                <!--<TextBlock Canvas.Left="0" Canvas.Top="198" Text="{Binding Path=Rating}" FontSize="20" Background="#7F000000"/>-->
                                <StackPanel Orientation="Horizontal" Canvas.Top="198">
                                    <Path Fill="Gold" Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                                                              Width="20"
                                                              Height="20"/>
                                    <TextBlock Text="{Binding Path=Rating, StringFormat='{}{0:0.0}'}"
                                                               FontSize="20" Margin="2,0,0,0"
                                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <!--<TextBlock Canvas.Left="0" Canvas.Top="0" Text="{Binding Path=Similiar}" Foreground="Yellow" FontSize="25" Background="#5F000000"/>-->
                            </Canvas>
                            <TextBlock x:Name="titleText" TextWrapping="Wrap" Width="148" Height="50" Text="{Binding Path=Title}" FontSize="15"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True" >
                            <Setter Property="BorderBrush" Value="Black" />
                            <Setter Property="Background" Value="Pink" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False" >
                            <Setter Property="BorderBrush" Value="White" />
                            <Setter Property="Background" Value="#2B373E" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Seasons -->
        <ScrollViewer x:Name="SeasonsScrollView" Grid.Row="1" Grid.Column="1" Visibility="Visible" BorderThickness="0" >
            <ItemsControl x:Name="SeasonsItemControl" ItemsSource="{Binding Path=SelectedSeries.Seasons}" BorderThickness="0" >
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Background="Transparent">
                            <TextBlock Text="{Binding SeasonId}" FontWeight="Bold" Margin="0,5,0,2" Foreground="White" FontSize="20"/>
                            <ListBox x:Name="EpisodesListBox" ItemsSource="{Binding Episodes}" 
                                 SelectedItem="{Binding SelectedEpisode}"
                                 SelectionChanged="Episodes_SelectionChanged"
                                 Background="Transparent">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="Black" BorderThickness="5" Margin="0" Padding="0" CornerRadius="2" Background="Transparent">
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Top" Background="Transparent">
                                                <Image Width="225" Source="{Binding Path=Poster, TargetNullValue={x:Null}}" VerticalAlignment="Top" />
                                                <TextBlock x:Name="titleText" TextWrapping="Wrap" Width="225" Height="50" Text="{Binding Path=Title}" FontSize="15" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True" >
                                                <Setter Property="BorderBrush" Value="Black" />
                                                <Setter Property="Background" Value="Pink" />
                                                <Setter Property="Foreground" Value="Black" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False" >
                                                <Setter Property="BorderBrush" Value="White" />
                                                <Setter Property="Background" Value="#2B373E" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
