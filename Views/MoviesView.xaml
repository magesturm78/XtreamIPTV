<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             mc:Ignorable="d" 
             x:Class="XtreamIPTV.Views.MoviesView"
             d:DesignHeight="720" d:DesignWidth="1080">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="420"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.31,0.3" EndPoint="1,1">
                <GradientStop Color="#1D252B" Offset="0.0" />
                <GradientStop Color="White" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>
        <!-- CATEGORY LIST -->
        <ListBox Grid.RowSpan="2" Background="#2B373E" Foreground="White" FontSize="18" BorderThickness="0"
                 ItemsSource="{Binding Categories}" 
                 SelectedItem="{Binding SelectedCategory}"
                 SelectionChanged="ListBox_SelectionChanged_1"
                 DisplayMemberPath="Name" 
                 Height="{Binding ActualHeight, ElementName=LayoutRoot}"/>
        <!-- MOVIE DETAILS -->
        <Canvas Grid.Row="0" Grid.Column="1" x:Name="MovieInfoCanvas" Height="390" >
            <Image Source="{Binding SelectedMovie.Backdrop, TargetNullValue={x:Null}}" Height="420" Canvas.Right="20" Canvas.Top="-15"/>
            <StackPanel Width="800" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Top="8" Canvas.Left="8">
                <TextBlock Text="{Binding SelectedMovie.Title}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap" Foreground="White" />
                <TextBlock Text="{Binding SelectedMovie.ReleaseInfo}" FontSize="15" TextWrapping="Wrap" Foreground="White" Margin="0,5,0,0" />
                <TextBlock Text="{Binding SelectedMovie.Plot}" FontSize="20" TextWrapping="Wrap" Foreground="White" Margin="0,5,0,0" />
                <TextBlock Text="{Binding SelectedMovie.DirectorInfo}" FontSize="10" TextWrapping="Wrap" Foreground="White" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding SelectedMovie.CastInfo}" FontSize="10" TextWrapping="Wrap" Foreground="White" Margin="0,10,0,0"/>
            </StackPanel>
            <Button x:Name="PlayButton" Content="Play" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="175" Click="Button_Click"/>
            <Button x:Name="PlayButton2" Content="External" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="5" Click="PlayButton2_Click"/>
            <Button x:Name="FavoriteButton" Content="Favorite" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="345" Click="FavoriteButton_Click"/>
            <Button x:Name="SimiliarButton" Content="Similiar" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="515" Click="SimiliarButton_Click"/>
            <Button x:Name="RemoveHistButton" Content="Remove" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="685" Click="RemoveHistButton_Click"/>
            <Button x:Name="BackButton" Content="Back" Width="150" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="5" 
                Background="LightBlue" FontWeight="Bold" FontSize="25" Canvas.Bottom="5" Canvas.Left="685" Click="BackButton_Click" Visibility="Hidden"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Top="-14">

                <ToggleButton x:Name="SortTogglePopupButton" Content="Sort" Margin="5,0,0,0" FontSize="15" />

                <Popup IsOpen="{Binding IsChecked, ElementName=SortTogglePopupButton}"
                               PlacementTarget="{Binding ElementName=SortTogglePopupButton}"
                               Placement="Bottom"
                               AllowsTransparency="True" 
                               StaysOpen="False">
                    <Border BorderThickness="1" Background="LightBlue" Padding="0">
                        <StackPanel x:Name="SortPanel">
                            <Button Content="Default" Click="DefaultSort_Click" FontSize="20" FontWeight="Bold"/>
                            <Button Content="Date" Click="DateSort_Click" FontSize="20"/>
                            <Button Content="Name" Click="NameSort_Click" FontSize="20"/>
                            <Button Content="Popularity" Click="PopularitySort_Click" FontSize="20"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <ToggleButton x:Name="DecadeTogglePopupButton" Content="Decade" Margin="5,0,0,0" FontSize="15" />

                <Popup IsOpen="{Binding IsChecked, ElementName=DecadeTogglePopupButton}"
                               PlacementTarget="{Binding ElementName=DecadeTogglePopupButton}"
                               Placement="Bottom"
                               AllowsTransparency="True" 
                               StaysOpen="False">
                    <Border BorderThickness="1" Background="LightBlue" Padding="0">
                        <StackPanel x:Name="DecadePanel"/>
                    </Border>
                </Popup>

                <ToggleButton x:Name="LanguageTogglePopupButton" Content="Language" Margin="5,0,0,0" FontSize="15" />

                <Popup IsOpen="{Binding IsChecked, ElementName=LanguageTogglePopupButton}"
                               PlacementTarget="{Binding ElementName=LanguageTogglePopupButton}"
                               Placement="Bottom"
                               AllowsTransparency="True" 
                               StaysOpen="False">
                    <Border BorderThickness="1" Background="LightBlue" Padding="0">
                        <StackPanel x:Name="LanguagePanel"/>
                    </Border>
                </Popup>
            </StackPanel>
        </Canvas>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" >
            <TextBlock Text="{Binding FilteredMovies.Count, StringFormat=\{0\}}" FontSize="20" Margin="10,0,0,0" Foreground="White" Background="#7F000000"/>
            <TextBlock Text="{Binding FilteredMoviesCount, StringFormat=' / \{0\}'}" FontSize="20" Margin="0,0,30,0" Foreground="White" Background="#7F000000"/>
        </StackPanel>
        <!-- MOVIE LIST -->
        <ListBox x:Name="MoviesListBox"  Grid.Row="1" Grid.Column="1" 
                 ItemsSource="{Binding FilteredMovies}" BorderThickness="0" Background="Transparent"
                 SelectedItem="{Binding SelectedMovie}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="ListBox_SelectionChanged" ScrollViewer.ScrollChanged="ListBox_ScrollChanged" >
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black"  BorderThickness="4" Margin="0" Padding="0" CornerRadius="10" Background="Transparent">
                        <StackPanel Orientation="Vertical" VerticalAlignment="Top" Background="Transparent" >
                            <Canvas Height="230" Width="154">
                                <Image Width="154" Source="{Binding Poster, TargetNullValue={x:Null}}" VerticalAlignment="Top" />
                                <TextBlock Canvas.Left="0" Canvas.Top="198" Text="{Binding Rating}" FontSize="20" Background="#7F000000"/>
                                <!--<TextBlock Canvas.Left="0" Canvas.Top="0" Text="{Binding Path=Similiar}" Foreground="Yellow" FontSize="25" Background="#5F000000"/>-->
                            </Canvas>
                            <TextBlock x:Name="titleText" TextWrapping="Wrap" Width="150" Height="50" Text="{Binding Title}" FontSize="15"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True" >
                            <Setter Property="BorderBrush" Value="Black" />
                            <Setter Property="Background" Value="Pink" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False" >
                            <Setter Property="BorderBrush" Value="White" />
                            <Setter Property="Background" Value="#2B373E" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="LightSteelBlue" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>